# Cockpit Landing — environment variables
# Copy this file to .env.local for local development.
# In production (Railway), set these via the dashboard, not via committed files.

# Public base URL of the deployed landing site (used for canonical URLs, OG tags, etc.)
NEXT_PUBLIC_BASE_URL=https://cockpit.mauritsgroup.com

# Public URL of the SaaS application (where "Inloggen" CTAs point to)
NEXT_PUBLIC_APP_URL=https://app.cockpit.mauritsgroup.com

# Node runtime mode — Railway sets this automatically on deploys
NODE_ENV=production

# Optional: Sentry error monitoring (reuse maurits-group org credentials)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ORG=maurits-group
# SENTRY_PROJECT=cockpitlanding
# SENTRY_AUTH_TOKEN=
